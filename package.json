{
  "name": "bhoot-links",
  "version": "0.1.0",
  "description": "A ghost link exorcist for college syllabi: finds dead, possessed and reincarnated links, with open-weight Gemma as the ojha.",
  "type": "module",
  "license": "MIT",
  "author": "Aarish mansur",
  "bin": {
    "bhoot": "./bin/bhoot.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bhoot": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "report": "tsx src/cli.ts report",
    "demo": "tsx src/cli.ts demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "npm run preview --workspace web"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.139",
    "@browserbasehq/stagehand": "^3.7.3",
    "@sentry/node": "^11.10.0",
    "ai": "^6.0.317",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.15",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "web"
  ]
}
