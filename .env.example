# Copy to .env and fill in what you have. Everything is optional:
# with no keys at all, `npm run demo` still runs end to end on fake data.

# Gemma, the ojha. Free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
# Used only if the main model errors out (quota, outage). Leave blank to fall back to rules.
LLM_FALLBACK_MODEL=
# Gap between Gemma calls, to stay inside free tier rate limits
LLM_MIN_INTERVAL_MS=2500

# Browser for suspicious pages: browserbase | local | off
BROWSER_PROVIDER=browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Hard caps so one scan cannot burn your free Browserbase minutes
MAX_BB_SESSIONS=1
MAX_RENDER_PAGES=25
# Only for BROWSER_PROVIDER=local
CHROME_PATH=

# Sentry agent tracing (optional). Spans use the gen_ai.* conventions.
SENTRY_DSN=

# Politeness and probing
BHOOT_USER_AGENT=
PROBE_TIMEOUT_MS=10000
PER_HOST_DELAY_MS=1000
PROBE_CONCURRENCY=6
MAX_REDIRECTS=8
# Try https:// first for http:// links (useful behind proxies that break plain http)
HTTP_UPGRADE=0
# system | doh (Cloudflare DNS over HTTPS, for networks that fake DNS answers)
DNS_RESOLVER=system

# Wayback Machine
WAYBACK=1
WAYBACK_MAX_CHECKS=3

OUT_DIR=out
